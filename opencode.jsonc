{
  "$schema": "https://opencode.ai/config.json",
  // Build and Plan default to the free DeepSeek V4.1 Flash at high reasoning effort.
  "agents": {
    "build": { "model": "opencode/deepseek-v4.1-flash-free#high" },
    "plan": { "model": "opencode/deepseek-v4.1-flash-free#high" }
  },
  // Only these providers are usable. Anything not allowed below is denied.
  // Statements match in order and the last match wins, so the deny-all comes first.
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },

    // OpenCode's own inference: the free models live here (e.g. *-free).
    { "action": "provider.use", "resource": "opencode", "effect": "allow" },

    // Major model families.
    { "action": "provider.use", "resource": "deepseek", "effect": "allow" },
    { "action": "provider.use", "resource": "meta", "effect": "allow" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" },
    { "action": "provider.use", "resource": "anthropic", "effect": "allow" }
  ]
}
